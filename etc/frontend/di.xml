<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\CustomerData\AbstractItem">
        <plugin name="majistar_product_labels_item_labels" type="Majistar\ProductLabels\Plugin\CustomerData\AddItemLabels"/>
    </type>
    <type name="Magento\Catalog\Block\Product\AbstractProduct">
        <plugin name="majistar_product_labels_mark_listing_image"
                type="Majistar\ProductLabels\Plugin\Catalog\MarkListingImage"/>
    </type>
    <type name="Magento\Checkout\Block\Cart\Item\Renderer">
        <plugin name="majistar_product_labels_mark_cart_image" type="Majistar\ProductLabels\Plugin\Checkout\MarkCartImage"/>
    </type>
    <type name="Magento\Catalog\Block\Product\Image">
        <plugin name="majistar_product_labels_image_badges" type="Majistar\ProductLabels\Plugin\Catalog\AddBadgesToImage"/>
    </type>
</config>

<?xml version="1.0"?>
<ruleset name="Majistar_ProductLabels">
    <description>Coding standard of Majistar_ProductLabels.</description>

    <config name="ignore_warnings_on_exit" value="1"/>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php,phtml"/>
    <arg name="parallel" value="8"/>

    <rule ref="Magento2"/>

    <file>Api</file>
    <file>Block</file>
    <file>Controller</file>
    <file>Model</file>
    <file>Observer</file>
    <file>Plugin</file>
    <file>Test</file>
    <file>Ui</file>
    <file>ViewModel</file>
    <file>view</file>
    <file>registration.php</file>
</ruleset>
